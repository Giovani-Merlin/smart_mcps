{
  "mcpServers": {
    "agentmemory": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "git+https://github.com/Giovani-Merlin/smart_mcps.git", "smart-mcps-agentmemory"]
    },
    "notebooklm": {
      "type": "stdio",
      "command": "notebooklm-mcp"
    },
    "perplexity": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    }
  }
}
