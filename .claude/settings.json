{
  "permissions": {
    "allow": [
      "Bash(smart-mcps-perplexity *)",
      "Bash(codegraph *)",
      "mcp__codegraph__*",
      "mcp__plugin_smart-mcps_codegraph__*",
      "Bash(nlm *)",
      "Read(//home/gbm1996/.pyenv/**)",
      "Bash(pip show *)",
      "Bash(pip3 show *)",
      "Bash(python3 -c ' *)",
      "WebFetch(domain:docs.perplexity.ai)",
      "Read(//tmp/**)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(uv run pytest*)",
      "Bash(uv run python*)",
      "Bash(uv run ruff*)",
      "Bash(uv sync*)",
      "Bash(pytest*)",
      "Bash(python3 -m pytest*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(sort -u -t'\"' -k2)",
      "Bash(grep -v ':0$')"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v codegraph >/dev/null 2>&1 || exit 0; [ -d .codegraph ] || codegraph init; ( codegraph index --force >/dev/null 2>&1 & )"
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/hooks/scripts/ensure_formatters.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/scripts/save_research.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/scripts/lint_after_edit.py\""
          }
        ]
      }
    ]
  }
}
