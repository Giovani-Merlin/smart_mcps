{
  "permissions": {
    "allow": [
      "Bash(node \"$CLAUDE_PROJECT_DIR/hooks/scripts/*.mjs\")",
      "Bash(smart-mcps-agentmemory *)",
      "Bash(smart-mcps-perplexity *)",
      "Bash(codegraph *)",
      "Bash(nlm *)",
      "Bash(find /home/gbm1996/.pyenv -path \"*/site-packages/nlm*\" -name \"*.py\" 2>/dev/null | head -20)",
      "Read(//home/gbm1996/.pyenv/**)",
      "Bash(pip show *)",
      "Bash(pip3 show *)",
      "Bash(python3 -c ' *)",
      "WebFetch(domain:docs.perplexity.ai)",
      "Bash(find /home/gbm1996/wksp/smart_mcps/docs -type f 2>/dev/null | head -20; echo \"---sidecar check---\"; ls /tmp/.pplx_sidecar_* 2>/dev/null || echo \"no sidecars\")",
      "Read(//tmp/**)",
      "Bash(python3 -c \"import nlm; print\\(nlm.__file__\\)\")",
      "Bash(python3 -c \"import nlm_tools; print\\(nlm_tools.__file__\\)\")",
      "Bash(python3 -c \"import notebooklm; print\\(notebooklm.__file__\\)\")",
      "Bash(ln -s ../agents /home/gbm1996/wksp/smart_mcps/.claude/agents)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v codegraph >/dev/null 2>&1 || exit 0; [ -d .codegraph ] || codegraph init; codegraph index"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/scripts/session-start.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "edit|write|create|read|view|glob|grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/scripts/pre-tool-use.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/scripts/post-tool-use.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/scripts/post-tool-failure.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/scripts/save_research.py\""
          }
        ]
      },
      {
        "matcher": "edit|write|multiedit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/scripts/lint_after_edit.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/scripts/stop.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/scripts/session-end.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/scripts/prompt-submit.mjs\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/scripts/pre-compact.mjs\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/scripts/subagent-start.mjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/scripts/subagent-stop.mjs\""
          }
        ]
      }
    ]
  }
}
