{
  "hooks": {
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v codegraph >/dev/null 2>&1 || exit 0; [ -d .codegraph ] || codegraph init; codegraph index"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__notebooklm__(notebook_query|cross_notebook_query|notebook_query_status)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/strip_mcp_hook.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__perplexity__(perplexity_ask|perplexity_research|perplexity_reason|perplexity_search)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/strip_mcp_hook.sh\""
          }
        ]
      }
    ]
  }
}
